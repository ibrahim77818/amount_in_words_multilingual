<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_amount_words" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.amount.words</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Amount in Words" id="amount_in_words_settings">
                    <setting id="amount_words_lang_mode_setting" company_dependent="1"
                             help="Language used to spell the total of quotations, orders and invoices">
                        <field name="amount_words_lang_mode" class="o_light_label" widget="radio"/>
                    </setting>
                    <setting id="amount_words_wrap_setting"
                             help="Protects the printed amount against later additions">
                        <field name="amount_words_wrap"/>
                    </setting>
                    <setting id="amount_words_sale_report_setting"
                             help="Show &quot;Total (In Words)&quot; under the totals of the quotation / order PDF">
                        <field name="amount_words_on_sale_report"/>
                    </setting>
                    <setting id="amount_words_invoice_report_setting"
                             help="Show &quot;Total (In Words)&quot; under the totals of the invoice / credit note PDF">
                        <field name="amount_words_on_invoice_report"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
