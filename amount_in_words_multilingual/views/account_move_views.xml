<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_amount_words" model="ir.ui.view">
        <field name="name">account.move.form.amount.words</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[hasclass('oe_invoice_lines_tab')]" position="after">
                <div class="o_amount_total_words mt-2 text-muted" name="amount_total_words_box"
                     invisible="move_type == 'entry' or not amount_total_words">
                    <strong class="me-1">Total (In Words):</strong>
                    <field name="amount_total_words" class="d-inline" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
